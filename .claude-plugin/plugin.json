{
  "name": "woodstitch",
  "displayName": "Woodstitch TTS human eval",
  "version": "0.1.0",
  "description": "Paid human listeners judge your text-to-speech audio blind: pairwise preference or human-vs-AI detection, with confidence intervals. Adds the Woodstitch MCP tools and a skill that knows when and how to run a listening test.",
  "author": {
    "name": "Woodstitch LLC",
    "email": "support@woodstitch.com",
    "url": "https://woodstitch.com"
  },
  "homepage": "https://woodstitch.com/docs",
  "repository": "https://github.com/TaylorHawkes/woodstitch-plugin",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "keywords": [
    "tts",
    "text-to-speech",
    "human-eval",
    "listening-test",
    "voice",
    "speech",
    "evaluation",
    "mcp"
  ],
  "documentationUrl": "https://woodstitch.com/docs",
  "supportUrl": "https://woodstitch.com/contact",
  "privacyPolicyUrl": "https://woodstitch.com/legal/privacy",
  "termsOfServiceUrl": "https://woodstitch.com/legal/privacy",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Woodstitch API key",
      "description": "ws_live_... from https://woodstitch.com/app/api-keys. Leave empty to browse templates and pricing only.",
      "sensitive": true
    }
  },
  "mcpServers": {
    "woodstitch": {
      "command": "uvx",
      "args": [
        "woodstitch-mcp"
      ],
      "env": {
        "WOODSTITCH_API_KEY": "${user_config.api_key}"
      }
    }
  }
}